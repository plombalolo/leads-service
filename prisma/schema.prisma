generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Lead {
    id          String   @id @default(uuid())
    name        String
    email       String
    country     String
    serviceType String
    budget      Float
    comment     String?
    status      String // 'new' або 'priority'
    createdAt   DateTime @default(now())

    @@index([email, createdAt])
}
